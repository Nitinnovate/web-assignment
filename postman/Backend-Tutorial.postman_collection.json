{
  "info": {
    "name": "Backend Tutorial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"pass1234\"\n}"
        },
        "url": "{{baseUrl}}/api/users/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"pass1234\"\n}"
        },
        "url": "{{baseUrl}}/api/users/login"
      }
    },
    {
      "name": "Who Am I",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "Create Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.post && json.post._id) pm.collectionVariables.set(\"postId\", json.post._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Learning backend development\"\n}"
        },
        "url": "{{baseUrl}}/api/posts"
      }
    },
    {
      "name": "Read All Posts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/posts"
      }
    },
    {
      "name": "Read One Post",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      }
    },
    {
      "name": "Update Post",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated post title\"\n}"
        },
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      }
    },
    {
      "name": "Delete Post",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/logout"
      }
    },
    {
      "name": "Who Am I After Logout",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/me"
      }
    }
  ]
}
